# =====================================================================
# Web3Community - Variaveis de ambiente
# Copie este arquivo para .env e preencha apenas os valores que for usar.
# NUNCA comite o arquivo .env (ja esta no .gitignore).
# =====================================================================

# --- RPC URLs ---------------------------------------------------------
# URL HTTPS do node RPC para cada rede que for usar.
# Exemplos: Alchemy, Infura, QuickNode, Chainstack, publico.
SEPOLIA_RPC_URL=

# --- Conta de deploy --------------------------------------------------
# Private key (hex, SEM o prefixo 0x) da carteira que assinara os deploys.
# Use uma carteira dedicada de testnet, nunca sua carteira principal.
DEPLOYER_PRIVATE_KEY=

# --- Verificacao de contratos ----------------------------------------
# Necessaria para `hardhat verify` publicar o source no Etherscan/Sepolia.
ETHERSCAN_API_KEY=

# --- Relatorio de gas -------------------------------------------------
# Opcional. Se preenchido, o hardhat-gas-reporter converte custo pra USD.
COINMARKETCAP_API_KEY=

# Liga/desliga o gas reporter sem precisar editar o hardhat.config.ts.
# Use `npm run test:gas` para ligar ad-hoc.
REPORT_GAS=false
